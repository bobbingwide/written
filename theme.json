{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"customGradient": false,
			"gradients": [],
			"palette": [
				{
					"color": "#fff",
					"name": "White",
					"slug": "white"
				},
				{
					"color": "#0073AA",
					"name": "WordPress blue",
					"slug": "blue"
				},
				{
					"color": "#5a5f21",
					"name": "Link colour ",
					"slug": "link"
				},
				{
					"color": "#23282D",
					"name": "Dark grey",
					"slug": "dark-grey"
				},
				{
					"color": "#d5e0c1",
					"name": "Footer background",
					"slug": "footer-background"
				},
				{
					"color": "#f5f5f5",
					"name": "Body background",
					"slug": "body-background"
				}
			]
		},
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1400px"
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": false,
			"fontFamilies": [
				{
					"fontFamily": "trebuchet ms,Arial,Helvetica,Sans-Serif",
					"name": "Trebuchet",
					"slug": "trebuchet"
				},
				{
					"fontFamily": "Lato,sans-serif",
					"name": "Lato",
					"slug": "lato"
				},
				{
					"fontFamily": "Kristen ITC,Serif",
					"name": "Verse",
					"slug": "verse"
				}
			],
			"fontSizes": [
				{
					"name": "Footer 14.4px",
					"size": "14.4px",
					"slug": "footer"
				},
				{
					"name": "Extra small 12px",
					"size": "12px",
					"slug": "extra-small"
				},
				{
					"name": "normal 16px",
					"size": "16px",
					"slug": "normal"
				},
				{
					"name": "H4 medium 20px",
					"size": "20px",
					"slug": "medium"
				},
				{
					"fluid": false,
					"name": "H3 Large 24px",
					"size": "24px",
					"slug": "large"
				},
				{
					"fluid": {
						"max": "36px",
						"min": "18px"
					},
					"name": "H1 36px",
					"size": "36px",
					"slug": "h1"
				},
				{
					"fluid": {
						"max": "80px",
						"min": "18px"
					},
					"name": "Title 41px",
					"size": "41px",
					"slug": "title"
				}
			]
		}
	},
	"styles": {
		"blocks": {
			"core/group": {
				"color": {
					"background": "#fff"
				},
				"spacing": {
					"padding": {
						"bottom": "20px",
						"left": "5px",
						"right": "5px",
						"top": "20px"
					}
				}
			},
			"core/heading": {
				"spacing": {
					"margin": {
						"bottom": "10px",
						"left": "0px",
						"right": "0px",
						"top": "0px"
					}
				}
			},
			"core/paragraph": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--normal)"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--footer)"
				}
			},
			"core/post-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"core/separator": {
				"border": {
					"color": "var(--wp--preset--color--cyan-bluish-gray)",
					"width": "1px"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--trebuchet)",
					"fontSize": "var( --wp--preset--font-size--large)"
				}
			},
			"oik-bbw/wp": {
				"typography": {
					"fontSize": "var( --wp--preset--font-size--normal)"
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--body-background)"
		},
		"css": "span.twit.wordle span { \ncolor: white;\nbackground-color: #3a5f35;\npadding: 4px;\nborder: 2px solid white;\n}",
		"elements": {
			"h1": {
				"color": {
					"text": "var(--wp--preset--color--v-dark-grey)"
				},
				"typography": {
					"fontSize": "var( --wp--preset--font-size--h1)",
					"fontWeight": "var( --wp--preset--font-weight--normal )"
				}
			},
			"h3": {
				"color": {
					"text": "var(--wp--preset--color--v-dark-grey)"
				},
				"typography": {
					"fontSize": "var( --wp--preset--font-size--large)",
					"fontWeight": "var( --wp--preset--font-weight--normal )"
				}
			},
			"h4": {
				"color": {
					"text": "var(--wp--preset--color--v-dark-grey)"
				},
				"typography": {
					"fontSize": "var( --wp--preset--font-size--medium)",
					"fontWeight": "var( --wp--preset--font-weight--normal )"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--link)"
				}
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--lato)",
			"lineHeight": 1.625
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header"
		},
		{
			"area": "footer",
			"name": "footer"
		}
	]
}